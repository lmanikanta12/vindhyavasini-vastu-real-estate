# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Frontend address (used for CORS and links inside emails)
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/vastu_estates
# MongoDB Atlas (free): paste your connection string here instead
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vastu_estates

# ---------- Security ----------
# Any long random text. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-text
JWT_EXPIRES_IN=7d

# ---------- First admin (used by: npm run seed:admin) ----------
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_PHONE=+919999999999

# ---------- Email (free: Gmail SMTP with an App Password) ----------
# Gmail: turn on 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste the 16 letters below.
# Leave SMTP_USER empty to just print emails in the terminal (handy for testing).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vindhyavasini Vastu and Real Estate <your-gmail@gmail.com>"

# ---------- Photo storage (Cloudinary, free plan) ----------
# Leave empty to save uploads in backend/uploads (fine on your own computer).
# On free hosting the disk is wiped on restart, so fill these in there.
# Cloudinary dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=vastu-estates

# ---------- Payments (Razorpay, free in Test mode) ----------
# Dashboard -> Settings -> API Keys -> Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Dashboard -> Webhooks -> secret you set there
RAZORPAY_WEBHOOK_SECRET=
# razorpay | demo   (leave empty: razorpay when keys exist, otherwise demo)
PAYMENT_MODE=
